# ───────── REQUIRED ─────────
# Token from @BotFather
BOT_TOKEN=PASTE_YOUR_BOT_TOKEN_HERE

# ───────── RECOMMENDED ─────────
# Your numeric Telegram ID (get it from @userinfobot). Comma-separate for several admins.
ADMIN_IDS=

# ───────── OPTIONAL ─────────
# Private bot: only these user IDs may use it (leave empty = everyone). Admins are always allowed.
ALLOWED_USERS=

# Max upload size in MB (49 for the normal Bot API; up to 1990 with a self-hosted Bot API server)
MAX_UPLOAD_MB=49

# Self-hosted Telegram Bot API server, e.g. http://127.0.0.1:8081/bot  (leave empty for normal)
API_BASE_URL=

# Playlist: max items per request
MAX_PLAYLIST_ITEMS=25

# How many downloads may run at the same time (others wait in a queue)
MAX_CONCURRENT_JOBS=2

# Seconds a user must wait between link requests
COOLDOWN_SECONDS=5

# Daily download limit per user (0 = unlimited, admins are exempt)
DAILY_LIMIT=0

# Reject videos longer than N minutes (0 = no limit)
MAX_VIDEO_MINUTES=0

# Path to a Netscape cookies.txt (helps with age-restricted videos / "confirm you're not a bot")
COOKIES_FILE=

# Advanced: JS runtime for yt-dlp YouTube challenges, e.g. node (requires: pkg install nodejs)
YTDLP_JS_RUNTIME=
